# Docker Compose only. Native development uses backend/.env instead.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
POSTGRES_DB=fable
POSTGRES_USER=fable
# Replace with a random URL-safe password before starting (see README).
POSTGRES_PASSWORD=replace-with-a-random-hex-password

STORY_PROVIDER=deepseek
STORY_GENERATION_MAX_ATTEMPTS=2
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_TOKENS=8192
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_TOKENS=8192
